# ── Обязательные переменные ──────────────────────────────────
# Токен Telegram-бота (оставьте пустым, если бот не нужен)
TELEGRAM_TOKEN=

# ── Прокси для Telegram (опционально) ────────────────────────
# Локальный SOCKS5 на хосте:  TELEGRAM_PROXY=socks5://host.docker.internal:1080
# Локальный HTTP на хосте:    TELEGRAM_PROXY=http://host.docker.internal:8080
# Удалённый прокси:           TELEGRAM_PROXY=socks5://user:pass@host:port
TELEGRAM_PROXY=

# ── LLM (Ollama / OpenAI) ────────────────────────────────────
OPENAI_API_KEY=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1

# ── Опциональные настройки ───────────────────────────────────
# LLM_TIMEOUT=120s
# LLM_MODEL=qwen3:8b
# LLM_PROVIDER=ollama
# LOG_LEVEL=info
# LOG_FORMAT=json
